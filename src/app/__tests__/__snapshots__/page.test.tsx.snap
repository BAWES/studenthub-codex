              class="flex items-start gap-2 text-sm"
              style="color: var(--ink);"
            >
              <span
                data-testid="icon-check"
              />
              Interview coaching and prep
            </li>
            <li
              class="flex items-start gap-2 text-sm"
              style="color: var(--ink);"
            >
              <span
                data-testid="icon-check"
              />
              CV writing service
            </li>
            <li
              class="flex items-start gap-2 text-sm"
              style="color: var(--ink);"
            >
              <span
                data-testid="icon-check"
              />
              Salary negotiation support
            </li>
          </ul>
          <a
            class="uiButton uiButton_defaultSize w-full justify-center uiButton_ghost"
            href="/signup?role=candidate&plan=premium"
          >
            Go Premium
             
            <span
              data-testid="icon-arrow-up-right"
            />
          </a>
        </div>
      </div>
    </section>
    <section
      aria-label="Get started"
      class="shSection relative overflow-hidden rounded-xl p-[clamp(24px,5vw,60px)] text-center"
      style="background: var(--sh-glass-bg); border: 1px solid var(--sh-glass-border);"
    >
      <div
        aria-hidden="true"
        class="shHeroGradientDramatic"
      />
      <div
        class="relative z-[2] max-w-[640px] mx-auto"
      >
        <p
          class="text-[var(--sh-info)] text-[11px] font-black uppercase tracking-wider mb-2"
        >
          Start your placement journey
        </p>
        <h2
          class="shBenefitsTitle text-center"
        >
          Your next role is one profile away.
        </h2>
        <p
          class="max-w-[480px] mx-auto mt-2 mb-6 leading-relaxed"
          style="color: var(--muted);"
        >
          Create your free profile in under 3 minutes. No CV required — just your experience and what you're looking for. Employers are hiring right now.
        </p>
        <a
          class="uiButton uiButton_default uiButton_lg shGlowButton"
          href="/signup?role=candidate"
        >
          Create your free candidate profile
           
          <span
            data-testid="icon-chevron-right"
          />
        </a>
        <div
          class="flex items-center justify-center gap-4 mt-4 text-xs"
          style="color: var(--muted);"
        >
          <span>
            1,200+ candidates placed this year
          </span>
          <span>
            4.8★ satisfaction
          </span>
        </div>
      </div>
    </section>
    <footer
      class="shSection flex items-center justify-between pt-4 pb-2 text-xs"
      style="color: var(--muted);"
    >
      <span>
        © 
        2026
         StudentHub. All rights reserved.
      </span>
      <div
        class="flex items-center gap-4"
      >
        <a
          class="hover:text-[var(--ink)] transition-colors no-underline"
          href="/login"
          style="color: inherit;"
        >
          Sign in
        </a>
        <a
          class="hover:text-[var(--ink)] transition-colors no-underline"
          href="/signup?role=candidate"
          style="color: inherit;"
        >
          Sign up as 
          candidate
        </a>
      </div>
    </footer>
  </main>
</div>
`;
