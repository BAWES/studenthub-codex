        >
          Role-based access and audit logs
        </span>
        <span
          class="shHeroPill"
        >
          Bulk invoicing and payment runs
        </span>
        <span
          class="shHeroPill"
        >
          Production-data validation tools
        </span>
      </div>
    </div>
  </section>
</div>
`;

