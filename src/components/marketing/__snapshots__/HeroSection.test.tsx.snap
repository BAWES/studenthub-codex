                £2.1M MTD
              </strong>
            </div>
            <div
              class="min-h-[92px] grid content-between rounded-lg p-3 bg-[var(--sh-glass-bg)]"
              style="border: 1px solid var(--sh-glass-border);"
            >
              <span
                class="text-[var(--sh-info)] text-[10px] font-black uppercase tracking-wider"
              >
                Compliance
              </span>
              <strong
                class="text-lg"
                style="color: var(--ink);"
              >
                98%
              </strong>
            </div>
            <div
              class="min-h-[92px] grid content-between rounded-lg p-3 bg-[var(--sh-glass-bg)]"
              style="border: 1px solid var(--sh-glass-border);"
            >
              <span
                class="text-[var(--sh-info)] text-[10px] font-black uppercase tracking-wider"
              >
                Payroll
              </span>
              <strong
                class="text-lg"
                style="color: var(--ink);"
              >
                Processing
              </strong>
            </div>
          </div>
        </div>
        <div
          class="grid content-start gap-2.5 p-3.5 rounded-xl bg-[var(--sh-glass-bg)] max-lg:hidden"
        >
          <div
            class="min-h-[140px] grid content-end gap-2 rounded-lg p-[14px]"
            style="background: var(--sh-glass-bg-strong); border: 1px solid var(--sh-glass-border);"
          >
            <span
              class="text-[var(--sh-info)] text-[10px] font-black uppercase tracking-wider"
            >
              Action
            </span>
            <strong
              class="text-[18px] leading-[1.1]"
              style="color: var(--ink);"
            >
              Approve bulk payment run
            </strong>
            <small
              style="color: var(--muted);"
            >
              £284,500 across 142 workers. Review and approve in one action.
            </small>
          </div>
          <div
            class="min-h-[100px] grid content-between rounded-lg p-[14px]"
            style="background: var(--sh-glass-bg); border: 1px solid var(--sh-glass-border);"
          >
