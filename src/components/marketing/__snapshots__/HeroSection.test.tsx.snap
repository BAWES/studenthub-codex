          </div>
          <div
            class="min-h-[100px] grid content-between rounded-lg p-[14px]"
            style="background: var(--sh-glass-bg); border: 1px solid var(--sh-glass-border);"
          >
            <span
              class="text-[var(--sh-info)] text-[10px] font-black uppercase tracking-wider"
            >
              Preview
            </span>
            <div
              class="flex items-center gap-2"
            >
              <span
                class="size-6 rounded-full bg-[var(--sh-success-bg)] flex items-center justify-center"
              >
                <span
                  data-testid="icon-check-circle"
                />
              </span>
              <span
                class="text-xs text-[var(--ink)]"
              >
                Ready to process
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      class="relative z-[2] max-w-[690px] max-lg:max-w-none"
    >
      <p
        class="shHeroEyebrow"
      >
        <span
          data-testid="icon-sparkles"
        />
        StudentHub for staff
      </p>
      <h1
        class="shHeroTitle"
      >
        Place people faster.&lt;br /&gt;
        <span
          class="shHeroHighlight"
        >
          Less paperwork.
        </span>
      </h1>
      <p
        class="shHeroBody"
      >
        Match candidates to open roles in seconds. Send CVs, manage shortlists, track timesheets, and process payments — all from one operating desk built for high-volume placement.
      </p>
      <div
        class="flex flex-wrap items-center gap-3.5 mt-4 max-sm:flex-col max-sm:items-stretch"
      >
        <a
          class="uiButton uiButton_default uiButton_lg shGlowButton"
          href="/signup?role=staff"
        >
          Request staff access
           
          <span
            data-testid="icon-arrow-up-right"
          />
        </a>
        <a
          class="uiButton uiButton_ghost uiButton_lg"
          href="/login"
        >
          Sign in
        </a>
      </div>
      <div
        class="flex flex-wrap items-center gap-2 mt-[18px]"
      >
        <span
          class="shProofPill"
        >
          350+ staffing agencies use StudentHub · 62% faster placement
        </span>
      </div>
      <div
        aria-label="Key benefits for staff"
        class="flex flex-wrap gap-2 mt-2.5"
      >
        <span
          class="shHeroPill"
        >
          Typo-tolerant candidate search
        </span>
        <span
          class="shHeroPill"
        >
          Bulk CV export and shortlisting
        </span>
        <span
          class="shHeroPill"
        >
          Integrated timesheets and payroll
        </span>
      </div>
    </div>
  </section>
</div>
`;
