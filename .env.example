# =============================================================================
# StudentHub Next — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MYSQL_DATABASE="studenthub_sample"
MYSQL_USER="studenthub"
MYSQL_PASSWORD="studenthub"
MYSQL_ROOT_PASSWORD="studenthub_root"
DATABASE_URL="mysql://studenthub:studenthub@mysql:3306/studenthub_sample"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-long-local-secret"

# ---------------------------------------------------------------------------
# Redis (cache / session — optional for now, used in future releases)
# ---------------------------------------------------------------------------
REDIS_URL="redis://redis:6379"

# ---------------------------------------------------------------------------
# S3 / Object Storage (MinIO-compatible or real AWS S3)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER="studenthub"
MINIO_ROOT_PASSWORD="studenthub_minio_secret"

# For MinIO (local dev / Docker Compose):
AWS_ENDPOINT_URL="http://minio:9000"
AWS_S3_FORCE_PATH_STYLE="true"
AWS_TEMP_BUCKET_REGION="us-east-1"
AWS_TEMP_ACCESS_KEY_ID="studenthub"
AWS_TEMP_SECRET_ACCESS_KEY="studenthub_minio_secret"
AWS_TEMP_BUCKET_NAME="studenthub-temp"

# For real AWS S3 (production cloud):
# AWS_ENDPOINT_URL=
# AWS_S3_FORCE_PATH_STYLE=
# AWS_TEMP_BUCKET_REGION=us-east-1
# AWS_TEMP_ACCESS_KEY_ID=AKIAXXXXXXXX
# AWS_TEMP_SECRET_ACCESS_KEY=...
# AWS_TEMP_BUCKET_NAME=studenthub-production-uploads

# Admin AWS config (legacy compatibility — mirrors above)
AWS_REGION="${AWS_TEMP_BUCKET_REGION:-us-east-1}"
AWS_DEFAULT_REGION="${AWS_TEMP_BUCKET_REGION:-us-east-1}"
AWS_S3_BUCKET="${AWS_TEMP_BUCKET_NAME:-studenthub-temp}"
AWS_BUCKET="${AWS_TEMP_BUCKET_NAME:-studenthub-temp}"
AWS_ACCESS_KEY_ID="${AWS_TEMP_ACCESS_KEY_ID}"

# ---------------------------------------------------------------------------
# Local development overrides (used by .env.local)
# ---------------------------------------------------------------------------
RAW_DUMP_PATH="../StudentHub Backup.sql"
SAMPLE_SQL_PATH="./data/studenthub-sample.sql"
